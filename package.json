{
  "name": "e-repetitor",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src api/src api/test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "api:build": "npm --prefix api run build",
    "api:start": "npm --prefix api start",
    "api:migrate": "npm --prefix api run migrate",
    "api:test": "npm --prefix api test",
    "check:all": "npm run check && npm run api:build && npm run api:test",
    "infra:up": "docker compose up -d --wait",
    "infra:stop": "docker compose stop"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
