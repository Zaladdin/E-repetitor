# Copy to api/.env; use the values configured for your local PostgreSQL.
DATABASE_URL=postgresql://e_repetitor:CHANGE_ME@127.0.0.1:55432/e_repetitor
# Must be a separate disposable database. The runner refuses names without _test.
TEST_DATABASE_URL=postgresql://e_repetitor:CHANGE_ME@127.0.0.1:55432/e_repetitor_test
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=E-Repetitor <noreply@e-repetitor.local>
# Explicitly enable only after reviewing the database and SMTP targets.
# Scans upcoming 60-minute lesson reminders and opted-in email every 30s.
# Always disabled in NODE_ENV=test. No third-party provider is configured here.
NOTIFICATION_WORKER_ENABLED=false
# Production SMTP usually needs credentials and SMTP_SECURE=true on port 465.
# SMTP_USER=
# SMTP_PASSWORD=
